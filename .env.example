# DeepSeek real-model smoke test. Offline CI and unit tests do not require these values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MODEL_NAME=deepseek-chat
# auto: use a configured real model, fake: force offline demo, real: require a model key.
DEMO_MODEL_MODE=auto

# Optional OpenAI fallback for the generic smoke-test entry.
OPENAI_API_KEY=

# M2 Agent Server (one deployment installs one approved product adapter set).
DEPLOYMENT_ID=local-product-a
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
PLUGIN_ID=demo-product-a
PLUGINS_DIR=
