# Required by the interactive A/B demo. Unit and E2E tests use isolated test doubles.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MODEL_NAME=deepseek-chat

# M2 Agent Server (one deployment installs one approved product adapter set).
DEPLOYMENT_ID=local-product-a
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
PLUGIN_ID=demo-product-a
PLUGINS_DIR=
# Manifest V2 only; comma-separated and deny-by-default when empty.
APPROVED_PLUGIN_NAMESPACES=
APPROVED_PLUGIN_PERMISSIONS=
