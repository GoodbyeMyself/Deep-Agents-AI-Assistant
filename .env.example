# Required by the interactive A/B demo. Unit and E2E tests use isolated test doubles.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MODEL_NAME=deepseek-chat

# Agent Server platform deployment.
DEPLOYMENT_ID=local
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Local stdio MCP configuration is intentionally omitted here. Set MCP_DEVELOPMENT_STDIO=true
# and MCP_SERVERS as trusted per-process environment variables; see LOCAL-DEVELOPMENT-STARTUP.md.
# Production deployments must not use stdio.

# Optional governed Platform Extensions. Only installed bare package names are accepted. Each entry must pin the
# extension ID, semantic version, and canonical manifest SHA-256. Paths, URLs, runtime uploads, and hot reload are
# rejected. Leave unset unless the deployment has approved an extension package.
# PLATFORM_EXTENSIONS=[]
# Reference-only approval for @assistant/platform-diagnostics-extension@1.0.0:
# PLATFORM_EXTENSIONS=[{"moduleSpecifier":"@assistant/platform-diagnostics-extension","approval":{"id":"platform-diagnostics","version":"1.0.0","manifestDigest":"5870fc5587a10d51f370cb8335ed2ec8070157dd43bd386bc852e5129de1b1fc"}}]
