{
  "name": "@assistant/agent-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "smoke:real": "tsx src/main.ts",
    "smoke:deepseek": "node --env-file=../../.env --import tsx src/main.ts",
    "serve": "node --env-file=../../.env --import tsx src/server-main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@assistant/agent-runtime": "workspace:*",
    "@assistant/capability-contracts": "workspace:*",
    "@assistant/context": "workspace:*",
    "@assistant/contracts": "workspace:*",
    "@assistant/evidence": "workspace:*",
    "@assistant/policy": "workspace:*",
    "@assistant/plugin-runtime": "workspace:*",
    "@langchain/core": "catalog:",
    "@langchain/langgraph": "catalog:",
    "@langchain/langgraph-checkpoint": "catalog:",
    "@langchain/openai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "4.21.0"
  }
}
