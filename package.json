{
  "name": "enterprise-ai-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "langsmith": "0.9.0",
      "zod": "4.3.6"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:server": "pnpm --filter @assistant/agent-server serve:m2",
    "dev:web": "pnpm --filter @assistant/assistant-web dev",
    "e2e": "pnpm --filter @assistant/assistant-web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm build && pnpm -r --if-present test",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "26.1.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.3.0",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "5.0.2"
  }
}
