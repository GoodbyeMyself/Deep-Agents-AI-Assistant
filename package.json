{
  "name": "enterprise-ai-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "langsmith": "0.9.0",
      "zod": "4.3.6"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:server": "pnpm --filter @assistant/agent-server serve",
    "dev:web": "pnpm --filter @assistant/assistant-web dev",
    "dev:copilotkit-spike": "pnpm --filter @assistant/copilotkit-shell-spike dev",
    "dev:embed": "pnpm --filter @assistant/assistant-embed dev",
    "pack:deploy": "node deploy/pack.mjs",
    "pack:local": "node deploy/pack-local.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test:identity-http": "pnpm --filter @assistant/agent-server... build && node --test tests/identity/http-profile-identity.test.mjs",
    "test": "pnpm test:mcp-1 && pnpm test:mcp-http && pnpm test:platform-extensions && pnpm test:runtime-policy && pnpm test:ag-ui-poc && pnpm test:ag-ui-endpoint && pnpm test:ag-ui-command && pnpm test:ag-ui-hitl && pnpm test:ag-ui-host-action && pnpm test:ag-ui-chat-core && pnpm test:copilotkit-spike",
    "test:postgres": "pnpm --filter @assistant/agent-server... build && node --env-file=deploy/.env.local --test tests/postgres/persistence.test.mjs",
    "test:mcp-1": "pnpm --filter @assistant/agent-server... build && node --test tests/mcp-1/client-runtime.test.mjs tests/mcp-1/agent-server-mcp-config.test.mjs",
    "test:mcp-http": "pnpm --filter @assistant/agent-server... build && node --test tests/mcp-1/http-runtime.test.mjs",
    "test:mcp-1:stdio": "pnpm --filter @assistant/agent-server... build && node --test tests/mcp-1/stdio-integration.test.mjs",
    "test:mcp-1:stdio:multi": "pnpm --filter @assistant/agent-server... build && node --test tests/mcp-1/multi-stdio-integration.test.mjs",
    "test:platform-extensions": "pnpm --filter @assistant/agent-server... build && node --test tests/platform-extensions/platform-extension-runtime.test.mjs",
    "test:runtime-policy": "pnpm --filter @assistant/agent-server... build && node --test tests/runtime-policy/runtime-policy.test.mjs",
    "test:ag-ui-poc": "pnpm --filter @assistant/contracts build && node --test tests/ag-ui-poc/projection.test.mjs",
    "test:ag-ui-endpoint": "pnpm --filter @assistant/agent-server... --filter @assistant/assistant-transport... build && node --test tests/ag-ui-endpoint/endpoint.test.mjs",
    "test:ag-ui-command": "pnpm --filter @assistant/agent-server... build && node --test tests/ag-ui-command/command.test.mjs",
    "test:ag-ui-hitl": "pnpm --filter @assistant/agent-server... --filter @assistant/assistant-ui... build && node --test tests/ag-ui-hitl/hitl.test.mjs",
    "test:ag-ui-host-action": "pnpm --filter @assistant/agent-server... --filter @assistant/assistant-ui... --filter @assistant/iframe-bridge... build && node --test tests/ag-ui-host-action/host-action.test.mjs",
    "serve:ag-ui-hitl-fixture": "pnpm --filter @assistant/agent-server... build && node tests/ag-ui-hitl/browser-fixture-server.mjs",
    "test:ag-ui-chat-core": "pnpm --filter @assistant/assistant-ui... build && node --test tests/ag-ui-chat-core/chat-store.test.mjs",
    "test:copilotkit-spike": "pnpm --filter @assistant/agent-server... --filter @assistant/copilotkit-shell-spike build && node --test apps/copilotkit-shell-spike/tests/http-agent.test.mjs",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@langchain/core": "catalog:",
    "@types/node": "26.1.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.3.0",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vue-eslint-parser": "10.3.0"
  }
}
