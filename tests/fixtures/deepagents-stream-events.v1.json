      {
        "namespace": ["model_request:<run-id>"],
        "messageType": "ai",
        "toolNames": []
      }
    ]
  },
  "streamEventsV3": {
    "call": "agent.streamEvents(input, { version: 'v3' })",
    "projections": {
      "messages": "AsyncIterable of AI message lifecycles; observed count 2",
      "toolCalls": "AsyncIterable of tool-call lifecycles; observed root call name 'task'",
      "subagents": "AsyncIterable of SubagentRunStream; observed count 1",
      "output": "Promise of final graph state; observed keys include files and messages"
