    "model": "@langchain/core fakeModel"
  },
  "sanitization": "Run IDs and UUID namespace suffixes are replaced with stable placeholders; message content contains no credentials or business data.",
  "rawUpdates": {
    "call": "agent.stream(input, { streamMode: 'updates', subgraphs: true })",
    "itemShape": "[namespace: string[], chunk: Record<nodeName, stateUpdate>]",
    "observedSequence": [
